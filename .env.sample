# Adapterログの閾値: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL="INFO"
# 単一のOpenAI互換endpoint。API keyは認証を要求する場合だけ設定する。
OPENAI_BASE_URL="http://localhost:8000/v1"
OPENAI_API_KEY=""
OPENAI_STRUCTURE_MODEL="local-vision-model"
OPENAI_TRANSLATION_MODEL="local-translation-model"
OPENAI_REVIEW_MODEL="local-review-model"
# OPENAI_STRUCTURE_MODEL="google/gemma4:12b"
# OPENAI_REVIEW_MODEL="google/gemma4:12b"
# OPENAI_TRANSLATION_MODEL="google/gemma4:12b"
# OPENAI_STRUCTURE_MODEL="prism-ml/bonsai-27b"
# OPENAI_REVIEW_MODEL="prism-ml/bonsai-27b"
# OPENAI_TRANSLATION_MODEL="prism-ml/bonsai-27b"
OPENAI_EMBEDDING_MODEL="local-embedding-model"

# Structured output方式: json_object / json_schema / prompt
LLM_STRUCTURED_OUTPUT_MODE="json_object"
# STRUCTURE_INPUT_TOKENS + STRUCTURE_OUTPUT_TOKENS + LLM_IMAGE_TOKENS + LLM_SAFETY_TOKENS <= LLM_CONTEXT_TOKENS
# TRANSLATE_INPUT_TOKENS + TRANSLATE_OUTPUT_TOKENS + LLM_SAFETY_TOKENS <= LLM_CONTEXT_TOKENS
# REVIEW_INPUT_TOKENS + REVIEW_OUTPUT_TOKENS + LLM_SAFETY_TOKENS <= LLM_CONTEXT_TOKENS
LLM_CONTEXT_TOKENS="30208"
LLM_IMAGE_TOKENS="4096"
LLM_SAFETY_TOKENS="1024"
STRUCTURE_INPUT_TOKENS="8192"
# reasoningを出力に含むモデルで8,192トークンに達したため、STRUCTUREの出力枠を確保する。
STRUCTURE_OUTPUT_TOKENS="16384"
STRUCTURE_MAX_BLOCKS="64"
TRANSLATE_INPUT_TOKENS="8192"
# reasoningを出力に含むモデルで8,192トークンに達したため、TRANSLATEの出力枠を確保する。
TRANSLATE_OUTPUT_TOKENS="16384"
TRANSLATE_MAX_UNITS="64"
REVIEW_INPUT_TOKENS="8192"
# 1対象でも16,384トークンに達したモデル向けに、文脈予算内の出力枠を確保する。
REVIEW_OUTPUT_TOKENS="20992"
REVIEW_MAX_TARGETS="32"
LLM_RETRY_ATTEMPTS="3"
LLM_SPLIT_MAX_DEPTH="6"
LLM_REQUEST_TIMEOUT_SECONDS="1800"
LLM_TASK_DEADLINE_SECONDS="21600"
LLM_SCHEMA_MAX_BYTES="8192"
LLM_SCHEMA_MAX_DEPTH="4"
LLM_RESPONSE_MAX_BYTES="262144"
REVIEW_MAX_FINDINGS="32"
REVIEW_MAX_REVISIONS="32"
REVIEW_MAX_EDITS_PER_REVISION="16"

# Docling Serve
DOCLING_SERVER_URL="http://localhost:5001"
DOCLING_API_KEY=""
DOCLING_OCR_PRESET="tesseract"
DOCLING_OCR_LANG="eng"
DOCLING_FORCE_OCR="false"
PDF_SPLIT_PAGES="10"

# LLM以外のHTTP要求と外部process
HTTP_RETRY_ATTEMPTS="3"
HTTP_REQUEST_TIMEOUT_SECONDS="300"
EXTERNAL_TASK_DEADLINE_SECONDS="21600"

# LibreTranslate backend
LIBRETRANSLATE_URL="http://localhost:5000"
LIBRETRANSLATE_API_KEY=""

# RAG検索とRegister。Translate/Reviewでは一式未設定なら無効になる。
QDRANT_URI="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="translate-references"
