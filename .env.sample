# Run Repository。未設定時はRepository直下のruns/を使用する。
TRANSLATE_RUNS_DIR="runs"
TRANSLATE_RETRY_ATTEMPTS="3"
TRANSLATE_RETRY_BASE_SECONDS="1"
TRANSLATE_RETRY_MAX_SECONDS="30"
TRANSLATE_REQUEST_TIMEOUT_SECONDS="300"
TRANSLATE_TASK_DEADLINE_SECONDS="21600"

# OpenAI互換API（STRUCTURE、TRANSLATE、REVIEW、FIX、VERIFYで使用）
OPENAI_BASE_URL="http://litellm:4000"
OPENAI_API_KEY="sk-litellm-master-key"
OPENAI_STRUCTURE_MODEL="google/gemma4:31b"
OPENAI_REVIEW_MODEL="google/gemma4:31b"
OPENAI_TRANSLATION_MODEL="google/gemma4:31b"
OPENAI_EMBEDDING_MODEL="Qwen/Qwen3-Embedding:0.6B"
# 任意。未設定時はOPENAI_REVIEW_MODELをFIXにも使用する。
OPENAI_FIX_MODEL="google/gemma4:31b"

# LLM token予算（任意。Contextはdeployment上限16384へ制限される）
LLM_CONTEXT_TOKENS="16384"
LLM_OUTPUT_TOKENS="8192"
LLM_IMAGE_TOKENS="4096"

# Docling Serve（SPLIT後のPDF解析で使用）
DOCLING_SERVER_URL="http://docling:5001"
DOCLING_API_KEY="sk-docling-serve-api-key"
DOCLING_OCR_PRESET="tesseract"
DOCLING_OCR_LANG="eng"
DOCLING_FORCE_OCR="false"
PDF_SPLIT_PAGES="10"

# Langfuse観測（任意。障害時は警告して本処理を継続する）
LANGFUSE_PUBLIC_KEY="pk-lf-langfuse-project-public-key"
LANGFUSE_SECRET_KEY="sk-lf-langfuse-project-secret-key"
LANGFUSE_OTEL_HOST="http://langfuse-web:3000"

# LibreTranslate Backend（任意）
LIBRETRANSLATE_URL="http://libretranslate:8000"
LIBRETRANSLATE_API_KEY="your-libretranslate-api-key"

# Qdrant参照検索および登録（任意）
QDRANT_API_KEY="sk-qdrant-api-key"
QDRANT_URI="http://qdrant:6333"
QDRANT_COLLECTION="translate-references"
